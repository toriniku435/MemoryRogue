  m_TableData:
  - m_Id: 622297088
    m_Localized: 'Commands of every kind, well balanced, at a low price.

      For
      filling the gaps in your deck.'
    m_Metadata:
      m_Items: []
  - m_Id: 676823040
    m_Localized: 'A high-grade chip: rare commands come out more often,

      and
      epics far more.'
    m_Metadata:
      m_Items: []
  - m_Id: 66197573304320
    m_Localized: 'The chip handed out when a story starts.

      Mostly basic commands.'
    m_Metadata:
      m_Items: []
  - m_Id: 818861403766784
    m_Localized: 'Mostly attack and virus commands.

      For when you need more
      firepower.'
    m_Metadata:
      m_Items: []
  - m_Id: 818861445709824
    m_Localized: 'Mostly block and healing commands.

      For when you need to
      hold the line.'
    m_Metadata:
      m_Items: []
  - m_Id: 818861445709825
    m_Localized: 'Mostly special commands: memory, buffer, stun and more.

      For
      unusual strategies.'
    m_Metadata:
      m_Items: []
