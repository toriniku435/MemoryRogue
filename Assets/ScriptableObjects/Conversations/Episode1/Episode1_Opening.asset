  - _speaker: "\u3042\u306A\u305F"
    _text: "\uFF08\u4EEE\uFF09\u30A8\u30D4\u30BD\u30FC\u30C91 \u958B\u59CB\u306E\u4F1A\u8A71
      2/3\u3002\n\u53F0\u8A5E\u306F\u3053\u306E\u30A2\u30BB\u30C3\u30C8\u3092\u66F8\u304D\u63DB\u3048\u308C\u3070\u5DEE\u3057\u66FF\u3048\u3089\u308C\u307E\u3059\u3002"
